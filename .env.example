# --------------------------------------------------------------------
# Frontend (Next.js)
# --------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# --------------------------------------------------------------------
# Backend (Rust / Axum)
# --------------------------------------------------------------------
DATABASE_URL=postgres://devflow:devflow@localhost:5432/devflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=please-change-this-in-production-and-keep-it-secret
RUST_LOG=info,devflow_backend=debug,tower_http=info
PORT=8000

# --------------------------------------------------------------------
# GitHub / External Integrations (optional placeholders)
# --------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEBHOOK_SECRET=

# Copy this file to `.env` (backend) or `.env.local` (frontend)
# and replace the placeholder values before running the stack.
