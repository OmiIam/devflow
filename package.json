{
    "name": "devflow-monorepo",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "docker:dev": "docker compose up --build",
        "docker:down": "docker compose down -v",
        "docker:test": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit",
        "docker:test:down": "docker compose -f docker-compose.test.yml down -v",
        "lint": "eslint --max-warnings=0 \"frontend/**/*.{ts,tsx,js,jsx}\"",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:ci": "vitest run --coverage --reporter=junit --outputFile=artifacts/vitest-junit.xml",
        "test:e2e": "playwright test",
        "@playwright/test": "^1.49.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.2",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.0.0",
        "eslint-config-next": "^16.1.4",
        "prettier": "^3.2.5",
        "vitest": "^3.2.4",
        "jsdom": "^24.0.0",
        "@playwright/test": "^1.49.0"
    }
}
